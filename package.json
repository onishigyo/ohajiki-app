{
  "name": "ohajiki-app",
  "private": true,
  "version": "0.0.0",
  "description": "「時間通貨」おはじきの稼ぎを記録する iPad アプリ（個人プロジェクト）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onishigyo/ohajiki-app.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.127.0"
  }
}
